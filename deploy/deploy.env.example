# Copy to deploy/deploy.env and adjust. This file is safe to commit.
# Used by ./deploy.sh on the server (or via --remote).

# Domains (must already point at this server for --ssl)
WEB_DOMAIN=snap.cloudnexus.biz
API_DOMAIN=api.cloudnexus.biz

# Node API listen port (nginx proxies to 127.0.0.1:$BACKEND_PORT)
BACKEND_PORT=3000

# Where nginx serves the built CRA app
WEB_ROOT=/var/www/snap/web

# Let's Encrypt account email (required for --ssl)
CERTBOT_EMAIL=ops@cloudnexus.biz

# CRA production API/image URLs (defaults to https://$WEB_DOMAIN)
# REACT_APP_API_URL=https://snap.cloudnexus.biz/api
# REACT_APP_IMAGE_HOST=https://snap.cloudnexus.biz
