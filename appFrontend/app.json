{
  "expo": {
    "name": "SNAP",
    "slug": "snap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snap.app",
      "jsEngine": "hermes",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to show your current location on the map and provide ride services.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to location to show your current location on the map and provide ride services."
      },
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.snap.app",
      "jsEngine": "hermes",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "localIp": "10.77.205.48",
      "stripePublishableKey": "pk_test_51G7XqgIFQtDBTvihaeU6FZCsQuHg1NQIkdd8CTGL0ZulPMIjQZUmFSW80gOzDpGe5UezYoqkc55WmQhpyYtZdLmk00QmAVRon0",
      "googlePlacesApiKey": "YOUR_GOOGLE_PLACES_API_KEY",
      "eas": {
        "projectId": "04ad20e1-cff1-4422-a7b3-bdb123420968"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SNAP to use your location to show your current position on the map and provide ride services."
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      ]
    ],
    "scheme": "snap",
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "developmentClient": {
      "silentLaunch": true
    },
    "owner": "afanglamin",
    "packagerOpts": {
      "config": "metro.config.js"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "fonts": [
      {
        "asset": "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/AntDesign.ttf",
        "family": "AntDesign"
      },
      {
        "asset": "node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/Ionicons.ttf",
        "family": "Ionicons"
      }
    ]
  }
} 