# Copy to keystore.properties (gitignored) and set your upload keystore passwords.
# Or export MYAPP_UPLOAD_STORE_PASSWORD and MYAPP_UPLOAD_KEY_PASSWORD instead.
#
# MYAPP_UPLOAD_STORE_FILE is set in gradle.properties (upload-keystore.jks under android/app/).

MYAPP_UPLOAD_STORE_PASSWORD=your-store-password
MYAPP_UPLOAD_KEY_PASSWORD=your-key-password
