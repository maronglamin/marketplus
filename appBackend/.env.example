# Copy to .env and fill in real values. Never commit .env.
# Required for server startup (validated in src/config.ts)

# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
# Docker Compose: use host "postgres"
# Mac Homebrew: use "localhost" and your OS user, OR create role below
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snap?schema=public

# Mac Homebrew one-time setup (run as your Mac user, e.g. `psql -d postgres`):
#   CREATE ROLE postgres WITH LOGIN PASSWORD 'postgres' CREATEDB;
#   CREATE DATABASE snap OWNER postgres;
#   \c snap
#   GRANT ALL ON SCHEMA public TO postgres;

# --- JWT (min 32 characters) ---
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Twilio (SMS / OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://snap.cloudnexus.biz

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Firebase push notifications (Android native FCM tokens only) ---
# Required for Android push. iOS can use direct APNs below instead.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- Direct APNs (iOS native — no Expo relay, no Firebase on server for iOS) ---
# Create a .p8 key in Apple Developer → Keys → Apple Push Notifications service (APNs)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=biz.cloudnexus.snap.app
APNS_PRIVATE_KEY=
# Set true for App Store / TestFlight builds; false for Xcode debug builds
APNS_PRODUCTION=false

# --- Web push (VAPID) — browser / AppWebVersion (same as directPay / 7a-side) ---
# Generate keys: npx web-push generate-vapid-keys
WEB_PUSH_SUBJECT=mailto:support@cloudnexus.biz
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# --- Public URLs (images, webhooks, payment callbacks) ---
PUBLIC_BASE_URL=https://api.cloudnexus.biz
API_BASE_URL=https://api.cloudnexus.biz
APP_PUBLIC_BASE_URL=https://snap.cloudnexus.biz

# --- Yonna Forex (required if using Yonna payments) ---
YONNA_FOREX_API_URL=
YONNA_FOREX_SECRET_KEY=
YONNA_FOREX_CLIENT_ID=
YONNA_FOREX_WEBHOOK_SECRET=

# --- Wave payments (optional) ---
WAVE_API_BASE_URL=https://api.wave.com
WAVE_CHECKOUT_BEARER=
WAVE_WEBHOOK_SECRET=

# --- File uploads (optional) ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# --- App version checks (optional) ---
APP_VERSION_LATEST_IOS=
APP_VERSION_LATEST_ANDROID=
APP_VERSION_MIN_IOS=
APP_VERSION_MIN_ANDROID=
APP_UPDATE_MANDATORY=false
APP_UPDATE_MESSAGE=
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=
APP_VERSION_REQUIRE_EXACT=false

# --- Misc optional ---
# Provider/agent application approvals are handled in snap-admin, not this consumer API.
SEND_SMS_NOTIFICATIONS=false
CLIENT_BASE_URL=
WEB_APP_URL=
FRONTEND_BASE_URL=
